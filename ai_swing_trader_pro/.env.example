# Copy this file to `.env` and adjust values as needed.
# Never commit your real `.env` file.

# --- App ---
APP_NAME="AI Swing Trader Pro"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-.env

# --- Database (prefix: DB_) ---
DB_URL=sqlite:///./ai_swing_trader_pro.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_POOL_PRE_PING=true

# --- Logging (prefix: LOG_) ---
LOG_LEVEL=INFO
LOG_DIRECTORY=./logs
LOG_ROTATION=10 MB
LOG_RETENTION=14 days
LOG_SERIALIZE=false
