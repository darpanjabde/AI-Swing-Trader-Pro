# Copy this file to `.env` and adjust values as needed.
# Never commit your real `.env` file.

# --- App ---
APP_NAME="AI Swing Trader Pro"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-.env

# --- Database (prefix: DB_) ---
DB_URL=sqlite:///./ai_swing_trader_pro.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_POOL_PRE_PING=true

# --- Logging (prefix: LOG_) ---
LOG_LEVEL=INFO
LOG_DIRECTORY=./logs
LOG_ROTATION=10 MB
LOG_RETENTION=14 days
LOG_SERIALIZE=false

# --- Zerodha Kite Connect (prefix: KITE_) ---
# Get these from https://developers.kite.trade/apps after registering an app.
KITE_API_KEY=
KITE_API_SECRET=
# Optional: paste a previously issued access token to skip interactive login.
# Kite access tokens expire daily, so this is normally left blank in dev.
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=
KITE_REQUEST_TIMEOUT=7
